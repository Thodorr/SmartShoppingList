<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="150dp"
    android:layout_height="100dp"
    android:layout_marginLeft="20dp"
    android:layout_marginTop="5dp">

    <View
        android:id="@+id/textHolder"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:background="@drawable/layout_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/iconHolder"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/layout_bg_circle_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="34dp"
        android:layout_height="35dp"
        app:layout_constraintBottom_toBottomOf="@+id/iconHolder"
        app:layout_constraintEnd_toEndOf="@+id/iconHolder"
        app:layout_constraintStart_toStartOf="@+id/iconHolder"
        app:layout_constraintTop_toTopOf="@+id/iconHolder"
        app:srcCompat="@drawable/baseline_lunch_dining_24" />

    <TextView
        android:id="@+id/productNameView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:text="Name"
        android:textColor="?android:attr/textColor"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="@+id/textHolder"
        app:layout_constraintStart_toStartOf="@+id/textHolder"
        app:layout_constraintTop_toBottomOf="@+id/iconHolder" />

    <TextView
        android:id="@+id/productUnitView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unit"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/productNameView" />

</androidx.constraintlayout.widget.ConstraintLayout>